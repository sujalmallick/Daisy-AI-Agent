# ============================================================
# Environment variables & secrets — NEVER commit real keys
# ============================================================
.env
.env.*
!.env.example

# ---- Spotify / Spotipy token caches ----
.cache
.cache*
*.cache
.spotipy*

# ---- User config files (may contain API keys / auth headers) ----
# custom_mcps.json stores user-defined HTTP tools that can have
# Authorization headers, bearer tokens, webhook secrets, etc.
backend/config/custom_mcps.json
# voice_config.json is machine-local (no secrets currently, but good hygiene)
backend/config/voice_config.json

# ---- Generic credential / token file patterns ----
*.token
*.tokens
*.credentials
*.secret
*.secrets
token.json
credentials.json
service_account.json
gcloud_credentials.json

# ---- Screenshot / screen-capture cache ----
.daisy_cache/

# ============================================================
# Python
# ============================================================
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# ============================================================
# Node & Desktop frontend
# ============================================================
node_modules/
dist/
dist-ssr/
*.local

# ============================================================
# Tauri & Rust build artifacts
# ============================================================
desktop/src-tauri/target/
src-tauri/target/

# ============================================================
# Audio outputs & temporary files
# ============================================================
*.mp3
*.wav
*.log
*.tmp
*.temp

# ============================================================
# OS / editor noise
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~