      "my public ip"
    ],
    "enabled": true
  },
  {
    "name": "system_uptime",
    "description": "Returns current Windows PC uptime and boot status.",
    "type": "command",
    "command": "powershell -Command \"(Get-CimInstance -ClassName Win32_OperatingSystem).LastBootUpTime\"",
    "timeout": 10,
    "parameters": {},
    "trigger_phrases": [
      "system uptime",
      "pc uptime",
      "how long has my pc been on"
    ],
    "enabled": true
  }
