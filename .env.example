# ====================================================================
# Daisy 🌼 — Environment Variables Configuration (.env.example)
# ====================================================================
# IMPORTANT: Never commit your actual .env file with real secrets!
# Copy this file to .env and fill in your actual credentials.

# 1. Spotify Web API Credentials (https://developer.spotify.com/dashboard)
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIPY_REDIRECT_URI=http://localhost:8888/callback

# 2. Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Voice & Hardware Configuration
# Options: auto (detects RTX 3050 CUDA -> DirectML -> CPU), cuda, directml, cpu
DAISY_HARDWARE_TIER=auto
DAISY_WAKE_WORD=Daisy

# 4. MCP Server Settings
MCP_ENABLED_SERVERS=spotify,filesystem
